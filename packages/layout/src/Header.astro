---
import Logo from './Logo.astro';
const { siteName } = Astro.props;
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/"><Logo class="site-header__mark" />{siteName}</a>
    <nav class="site-header__nav" aria-label="Main">
      <a href="/#all-calculators" aria-current={path === '/' ? 'page' : undefined}>All calculators</a>
      <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
    </nav>
  </div>
</header>
