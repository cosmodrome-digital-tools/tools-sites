---
/**
 * Base page shell for every page on every site: <head> (SEO + JSON-LD + consent
 * stub), header, breadcrumbs, main, footer with legal links. Mobile-first.
 *
 * Props:
 *  site:        the site's src/site.config.mjs default export
 *  title:       full <title> (build with toolTitle()/pageTitle() from @tools/seo)
 *  description: meta description
 *  breadcrumbs: [{ name, href }] from home; BreadcrumbList JSON-LD is generated from it
 *  jsonLd:      extra JSON-LD objects (e.g. WebApplication)
 *  noindex:     true to add <meta name="robots" content="noindex">
 */
import './styles/base.css';
import SeoHead from '@tools/seo/SeoHead.astro';
import JsonLd from '@tools/seo/JsonLd.astro';
import { breadcrumbList, canonicalUrl } from '@tools/seo';
import ConsentHead from '@tools/consent/ConsentHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Breadcrumbs from './Breadcrumbs.astro';

const { site, title, description, breadcrumbs = [], jsonLd = [], noindex = false } = Astro.props;
const base = Astro.site ?? new URL(site.siteUrl);
const canonical = canonicalUrl(Astro.url.pathname, base);
const crumbLd = breadcrumbs.length > 1
  ? breadcrumbList(breadcrumbs.map((c) => ({ name: c.name, url: canonicalUrl(c.href, base) })))
  : null;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} canonical={canonical} noindex={noindex} siteName={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <JsonLd data={[crumbLd, ...jsonLd]} />
    <ConsentHead ads={site.ads} publisherId={site.publisherId} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header siteName={site.name} />
    <main id="main" class="site-main">
      <div class="site-container">
        <Breadcrumbs items={breadcrumbs} />
        <slot />
      </div>
    </main>
    <Footer siteName={site.name} />
  </body>
</html>
