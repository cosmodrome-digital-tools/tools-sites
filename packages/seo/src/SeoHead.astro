---
/**
 * <head> tags for every page: title, meta description, canonical, Open Graph,
 * and a Twitter card. Pass `title` already built with toolTitle()/pageTitle().
 *
 * image: optional { url, width, height, alt } with an ABSOLUTE url
 *        (build it with canonicalUrl()). Adds og:image* and switches the
 *        Twitter card to summary_large_image; without it the card is "summary".
 *        X/Twitter reads title, description, and image from the og: tags when
 *        twitter:title/description/image are absent, so only the card type is
 *        emitted (keeps every page's <head> small).
 * locale: Open Graph locale, default en_US.
 */
const { title, description, canonical, noindex = false, siteName, image, locale = 'en_US' } = Astro.props;
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content={locale} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
{siteName && <meta property="og:site_name" content={siteName} />}
{image && <meta property="og:image" content={image.url} />}
{image?.width && <meta property="og:image:width" content={String(image.width)} />}
{image?.height && <meta property="og:image:height" content={String(image.height)} />}
{image?.alt && <meta property="og:image:alt" content={image.alt} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
