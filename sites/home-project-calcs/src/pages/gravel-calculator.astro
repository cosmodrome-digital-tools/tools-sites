---
// GENERATED by `npm run new-tool` for the tool in tools/gravel-calculator/.
// Do not edit by hand. Tools change only files inside their own tool folder;
// this file just wires that folder into the site at /gravel-calculator/.
import ToolPage from '@tools/layout/ToolPage.astro';
import { getCollection, getEntry, render } from 'astro:content';
import site from '../site.config.mjs';
import '../styles/site.css';
import '../../tools/gravel-calculator/tool.css';

const slug = 'gravel-calculator';
const page = await getEntry('tools', slug);
const meta = await getEntry('toolMeta', slug);
if (!page || !meta) throw new Error(`Tool "${slug}" needs both page.md and meta.json in tools/${slug}/`);
const { Content } = await render(page);

// Optional hero image: tools/gravel-calculator/assets/hero.(svg|png|jpg|jpeg|webp|avif)
const heroes = import.meta.glob('../../tools/gravel-calculator/assets/hero.{svg,png,jpg,jpeg,webp,avif}', { eager: true, import: 'default' });
const hero = Object.values(heroes)[0];

const allMeta = await getCollection('toolMeta');
const related = (meta.data.relatedTools ?? [])
  .map((s) => allMeta.find((t) => t.id === s))
  .filter(Boolean)
  .map((t) => ({ slug: t.id, title: t.data.title }));
---
<ToolPage site={site} meta={meta.data} toolSlug={slug} hero={hero} related={related}>
  <Content />
</ToolPage>

<script>
  import '../../tools/gravel-calculator/ui.js';
</script>
