{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tools-home-project-calcs",
  // Set to the scaffold date; keep it fixed afterwards
  "compatibility_date": "2026-10-06",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",          // Astro's build output (outDir)
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "homeandyardcalcs.com", "custom_domain": true },
    { "pattern": "www.homeandyardcalcs.com", "custom_domain": true }
  ],
  // workers.dev remains the noindex preview (see public/_headers).
  "workers_dev": true,
  "preview_urls": true,
  "previews": {}
}
